{
  "schema": 2,
  "id": "solarized",
  "type": "theme",
  "name": "Solarized",
  "version": "2.0.0",
  "description": "Ethan Schoonover's Solarized palette, with a soft background and translucent panes.",
  "license": "MIT",
  "theme": {
    "mode": "light",
    "primary": "#268bd2",
    "secondary": "#2aa198",
    "tertiary": "#d33682",
    "error": "#dc322f",
    "radius": 10,
    "spacing": 8,
    "font": "system",
    "images": {
      "page": "background.png",
      "login": "background.png"
    },
    "imageFit": "cover",
    "parts": {
      "appBar": {
        "background": "#fdf6e3",
        "opacity": 0.75,
        "blur": 12
      },
      "sidebar": {
        "background": "#eee8d5",
        "opacity": 0.7,
        "blur": 12,
        "color": "#586e75"
      },
      "messageList": {
        "background": "#fdf6e3",
        "opacity": 0.75
      },
      "reader": {
        "background": "#fdf6e3",
        "opacity": 0.85
      },
      "button": {
        "radius": 32,
        "fontWeight": 600
      },
      "card": {
        "borderColor": "#93a1a1",
        "borderWidth": 1,
        "shadow": "none"
      },
      "composer": {
        "background": "linear-gradient(180deg, #fdf6e3, #eee8d5)",
        "shadow": "high"
      }
    }
  }
}
